{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "gen:api": "openapi-typescript ../../docs/features/biometric-pin-login/openapi.yaml -o src/api/generated/schema.d.ts",
    "mock": "tsx mocks/server.ts",
    "contract-test": "jest --selectProjects node",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:bundle": "node scripts/check-release-bundle.mjs",
    "export:release": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-modules-core": "~58.0.29",
    "expo-router": "~58.0.29",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^58.0.23",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  }
}
