# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# project
.env
.env.*
!.env.example
coverage/
/mocks/.cache

# The root .gitignore ignores every `ios/` and `android/` directory (generated native projects). The local native module's
# hand-written sources live in modules/biometric-key/{ios,android} and MUST be tracked: re-include them explicitly.
!/modules/biometric-key/ios/
!/modules/biometric-key/android/

# Native module build output
modules/biometric-key/android/build/
modules/biometric-key/android/.gradle/
modules/biometric-key/ios/build/
modules/biometric-key/ios/Pods/
