# PLACEHOLDERS ONLY. Copy to .env (git-ignored) and replace every CHANGE_ME. Never commit real values.
# Demo scope: localhost/LAN only. Never expose this server to the internet.

# --- Postgres (docker compose) ---
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cryptoapp
POSTGRES_PORT=5432
API_DB_USER=cryptoapp_api
API_DB_PASSWORD=CHANGE_ME

# --- API server ---
ENV=dev                       # dev | prod
DEMO_MODE=true                # refuses to start when ENV=prod
# Loopback by default (iOS simulator; Android: `adb reverse tcp:8080 tcp:8080`). The server speaks plain HTTP and the demo
# secret (root of trust for PIN reset) crosses the wire: set 0.0.0.0 only on a network you fully trust (LAN risk), never in prod.
LISTEN_ADDR=127.0.0.1:8080
# Runtime role (least privilege). sslmode=disable is rejected when ENV=prod.
DATABASE_URL=postgres://cryptoapp_api:CHANGE_ME@127.0.0.1:5432/cryptoapp?sslmode=disable
# Owner role, read ONLY by `cmd/migrate`, never by the server.
DATABASE_MIGRATE_URL=postgres://app_owner:CHANGE_ME@127.0.0.1:5432/cryptoapp?sslmode=disable
DB_MAX_CONNS=10

# --- Secrets (generate: openssl rand -base64 32) ---
PEPPER=CHANGE_ME_AT_LEAST_32_BYTES_BASE64
PEPPER_VERSION=1
# PEPPER_FILE=/run/secrets/pepper      # alternative to PEPPER
# Optional previous pepper for upgrade-on-login:
# PEPPER_OLD=
# PEPPER_OLD_VERSION=
ACCESS_SIGNING_KEY=CHANGE_ME_BASE64_OF_32_BYTE_ED25519_SEED
# username=secret pairs (>= 12 chars each). Seeded users are created at startup.
DEMO_SECRETS=alice=CHANGE_ME_ALICE_SECRET,bob=CHANGE_ME_BOB_SECRET

# --- Argon2id (demo floor m=19456 KiB t=2 p=1; prod m=65536 t=3 p=1) ---
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1
ARGON2_CONCURRENCY=4

# --- Lockout / sessions / step-up (seconds unless noted) ---
LOCK_SCHEDULE=30,60,300,900,3600   # waits after failure 5..9; failure 10 = hard lock
ACCESS_TTL=300
UNLOCK_WINDOW=900
IDLE_WINDOW=300
CHALLENGE_TTL=60
STEPUP_TOKEN_TTL=60
BOOTSTRAP_TTL=600

# --- Demo tunables (mock USD) ---
BIO_ONLY_MAX=1000
COOLING_OFF_DURATION=300        # demo: 5 min (production default 86400)
COOLING_OFF_MAX=500            # aggregate per COOLING_OFF_DURATION window (not per transaction)
COOLING_OFF_MAX_TX=5           # max transactions per cooling-off window
COOLING_OFF_WINDOW=300         # rolling window for the cooling-off aggregate (default: COOLING_OFF_DURATION)
BIO_ONLY_WINDOW=86400          # BIO_ONLY_MAX is an aggregate of biometric-approved value over this rolling window
MOCK_PRICES=BTC=65000,ETH=2500,USDC=1

# --- Misc ---
TRUSTED_PROXY=false
AUDIT_HASH_CHAIN=false
